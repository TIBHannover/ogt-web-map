{
    "name": "tibhannover/ogt-web-map",
    "type": "project",
    "description": "OGT project web map about places of Gestapo terror (1933-1945) in present-day Lower Saxony.",
    "homepage": "https://www.gestapo-terror-orte.de/",
    "keywords": [
        "gestapo",
        "laravel",
        "leaflet",
        "lower saxony",
        "map",
        "osm",
        "sparql",
        "vue",
        "vuetify",
        "wikidata"
    ],
    "license": "GPL-3.0-only",
    "authors": [
        {
            "name": "Nils Casties",
            "email": "nils.casties@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Sören Wachsmuth",
            "email": "soeren.wachsmuth@tib.eu",
            "role": "Developer"
        },
        {
            "name": "Lisa Groh-Trautmann",
            "email": "lisa.groh@tib.eu",
            "role": "Historian"
        }
    ],
    "require": {
        "php": "^8.2|^8.4",
        "guzzlehttp/guzzle": "^7.0.1",
        "illuminate/contracts": "^11",
        "laravel/framework": "^11.6",
        "laravel/tinker": "^2.5",
        "league/oauth1-client": "^1.11",
        "spatie/laravel-ignition": "^2.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/envoy": "^2.8",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/WikidataHelpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
