APP_NAME=ogt-api
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

DOCKER_VERSION=stable # or develop

ASSET_URL=http://127.0.0.1:8000
### needs new .env variable!
MIX_ASSET_URL=http://127.0.0.1:8000

MIX_APP_ENV=${APP_ENV}
MIX_BASE_URL=${MIX_ASSET_URL}
MIX_PROXY_PATH=
MIX_URL=

LOG_CHANNEL=daily
LOG_LEVEL=debug

DEPLOY_APP_DIR=/path/to/deploy/directory
DEPLOY_REPO=git@git.example:organization/team/ogt-web-map.git
DEPLOY_SLACK_WEBHOOK=https://hooks.slack.com/services/ABCDEF123/GHIJKLMN456/OPQRSTUVWXYZ7890abscdefg
DEPLOY_SLACK_WEBHOOK_ENABLED=false

DEPLOY_APP_URL_PRODUCTION=https://example.eu/ogt
DEPLOY_HOST_PRODUCTION=ogt.host.example.eu
DEPLOY_USER_PRODUCTION=productionDeployUserName

DEPLOY_APP_URL_TEST=https://test.example.eu/ogt
DEPLOY_HOST_TEST=ogt.testhost.example.eu
DEPLOY_USER_TEST=testDeployUserName

QUEUE_CONNECTION=database
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/app/database.sqlite

# Wikibase Configuration
WIKIBASE_DEBUG_MODE=true
EXPORT_TARGET=wikidata
WIKIBASE_CONSUMER_KEY=
WIKIBASE_CONSUMER_SECRET=
WIKIBASE_API_URL=https://test.wikidata.org/w/api.php

# Legacy Wikidata Config (deprecated)
WIKIDATA_BOT_USERNAME=GTOBot
WIKIDATA_BOT_PASSWORD=password
WIKIDATA_API_URL=https://test.wikidata.org/w/api.php

WIKIDATA_USE_STANDARD_FOR_ALL_LANGUAGES=true
WIKIDATA_ADD_ENGLISH_LABELS=false

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@gestapo-terror-orte.de
MAIL_FROM_NAME="Gestapo.Terror.Orte."
MAIL_ADMIN_ADDRESS=soeren.wachsmuth@tib.eu
